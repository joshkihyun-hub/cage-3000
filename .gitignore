# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Camera RAW files — should never be committed to a web project
*.NEF
*.RAW
*.CR2
*.ARW
*.DNG

# One-off scripts that aren't part of the runtime
/optimize-images.js

# Local Prisma artifacts — production uses prisma db push, not migrations
/prisma/dev.db
/prisma/migrations/
